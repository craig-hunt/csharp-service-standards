<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzer targets netstandard2.0 because Roslyn loads analyzers into
       the compiler process, which runs on .NET Standard rules rather than the
       target framework of the code it analyzes. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ServiceStandards.Analyzers</RootNamespace>
    <AssemblyName>ServiceStandards.Analyzers</AssemblyName>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);CS1591;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
