<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Web layer maps HTTP to the Application layer and back. It owns
       endpoints, authentication, problem details, and logging configuration,
       and it holds no business rule. -->
  <PropertyGroup>
    <RootNamespace>ServiceStandards.Web</RootNamespace>
    <AssemblyName>ServiceStandards.Web</AssemblyName>
    <UserSecretsId>csharp-service-standards</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\analyzers\LiteralAnalyzer\LiteralAnalyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceStandards.Web.Tests" />
  </ItemGroup>

</Project>
