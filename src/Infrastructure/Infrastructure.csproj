<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core lives here and nowhere else. The Domain never learns that a
       relational database exists. -->
  <PropertyGroup>
    <RootNamespace>ServiceStandards.Infrastructure</RootNamespace>
    <AssemblyName>ServiceStandards.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- The outbox relay runs as a hosted service. Abstractions carry
         BackgroundService without dragging a host into a class library. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\analyzers\LiteralAnalyzer\LiteralAnalyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
